AI_PROVIDER=groq
GROQ_API_KEY=replace-with-your-key
GROQ_CHAT_MODEL=openai/gpt-oss-20b
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# Optional Gemini alternative: set AI_PROVIDER=gemini and GEMINI_API_KEY.
# GEMINI_API_KEY=replace-with-your-key
GEMINI_CHAT_MODEL=gemini-3-flash-preview
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# Optional paid OpenAI alternative: set AI_PROVIDER=openai and OPENAI_API_KEY.
# OPENAI_API_KEY=replace-with-your-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_DATA_DIR=./data-local
RAG_MAX_RETRIES=2
RAG_TOP_K=4
# Optional web fallback after local search retries; obtain a key from Tavily.
# TAVILY_API_KEY=replace-with-your-key
